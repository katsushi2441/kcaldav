# CGI/FastCGI に Authorization ヘッダを渡す（Basic認証で必須）
<IfModule mod_rewrite.c>
  RewriteEngine On
  # PWA資産(manifest/sw)を kcaldav.php のPATH_INFO へ回す。
  # これで素の設置(kcaldav.php を置いただけ)でも「ホーム画面に追加」が動く。
  RewriteRule ^(manifest\.webmanifest|sw\.js)$ kcaldav.php/$1 [L]
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]
</IfModule>
# 保存データを直接読ませない
<FilesMatch "\.sqlite($|-)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
